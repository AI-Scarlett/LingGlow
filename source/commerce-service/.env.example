# Server secret manager values. Never copy this file or its values into LingGlow.app.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=

# Current canonical Product IDs are verified test-mode-only. live_mode is
# rejected until four separate live Product IDs replace the directory.
DODO_PAYMENTS_ENVIRONMENT=test_mode

SKIN_STUDIO_ENTITLEMENT_DATABASE_URL=
SKIN_STUDIO_DATABASE_SSL_MODE=verify-full
SKIN_STUDIO_DATABASE_CA_FILE=
SKIN_STUDIO_DATABASE_POOL_MAX=10
SKIN_STUDIO_DATABASE_CONNECT_TIMEOUT_MS=5000
SKIN_STUDIO_DATABASE_IDLE_TIMEOUT_MS=30000

SKIN_STUDIO_LEASE_SIGNING_KEY_REF=
SKIN_STUDIO_CHECKOUT_RETURN_URL=

# HTTPS origin only: no path, query, fragment, or embedded credentials.
SKIN_STUDIO_PUBLIC_BASE_URL=

# Built-in Dodo + PostgreSQL mode loads only auth/KMS from this audited module.
LINGGLOW_COMMERCE_TRUST_MODULE=

# Optional full composition override. When set, it must provide all five Ports.
LINGGLOW_COMMERCE_ADAPTER_MODULE=

COMMERCE_HOST=127.0.0.1
PORT=8787

# Exact proxy peer IPs seen by Node, comma separated. Do not use CIDRs.
COMMERCE_TRUSTED_PROXY_ADDRESSES=
COMMERCE_HEADERS_TIMEOUT_MS=15000
COMMERCE_REQUEST_TIMEOUT_MS=30000
COMMERCE_KEEP_ALIVE_TIMEOUT_MS=5000
COMMERCE_SHUTDOWN_TIMEOUT_MS=10000
